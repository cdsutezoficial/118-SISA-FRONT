# ──────────────────────────────────────────────
# SISA — variables del frontend
#
# Copia este archivo como .env y ajusta los valores. NO subas el .env al
# repositorio (ya esta en .gitignore); este archivo si se versiona.
#
# Docker Compose lee este archivo para resolver los ${...} del
# docker-compose.yml, y VITE_API_URL ademas viaja como ARG de build.
#
# El compose NO tiene valores por omision: si falta una variable de esta
# lista, `docker compose up` falla diciendo cual falta. Es a proposito, para
# que un .env incompleto no arranque un contenedor con un valor inventado.
# ──────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────
# URL publica del backend. Vite la incrusta en el bundle al compilar, asi
# que cambiarla exige reconstruir la imagen: docker compose up -d --build
#
#   local     → el API del compose del back, en http://localhost:8080
#   testdti   → la URL publica que publica el reverse proxy
#   prod      → idem, la publica
# En local, sin Docker (npm run dev), el Vite dev server corre en 5173 y el
# API tambien en 8080, asi que este valor sirve para los dos casos.
VITE_API_URL=http://localhost:8080

# ── Ruta publica de la app ──────────────────────────────────────────
# Ruta bajo la que el reverse proxy sirve el front. Vite la usa como `base`
# de los assets y el router como basename, asi que tambien exige reconstruir.
#   local     → /      (la app en la raiz: http://localhost:5173/login)
#   servidores → /SGA/ (https://cds.utez.edu.mx/SGA/login)
# El proxy debe quitar el prefijo antes de llegar al contenedor
# (proxy_pass http://host:puerto/;), porque NGINX sirve desde la raiz.
VITE_BASE_PATH=/

# ── Que archivo de configuracion es este ──────────────────────────────
# En los servidores, pon aqui mismo el nombre del archivo de ese ambiente
# (por ejemplo SISA_ENV_FILE=.env.testdti) y se carga solo.
SISA_ENV_FILE=.env

# ── Red de Docker ─────────────────────────────────────────────────────
# false = el compose crea la red. true = la red ya existe porque el reverse
# proxy vive ahi, y tiene que ser la MISMA que declara el compose del back:
#   local    → sisa-ui-net      / false
#   testdti  → net-cds-test     / true
#   prod     → sisava-network   / true
DOCKER_NETWORK=sisa-ui-net
DOCKER_NETWORK_EXTERNAL=false

# ── Puertos publicados en el host ─────────────────────────────────────
# 127.0.0.1 = solo accesible desde el propio servidor. Si el reverse proxy
# es un contenedor que entra por host.docker.internal, tiene que ser 0.0.0.0:
# host.docker.internal resuelve a la IP del bridge de Docker, no a 127.0.0.1.
#
# 5173 es el mismo puerto que usa el Vite dev server, para que
# SISA_CORS_ALLOWED_ORIGINS del back no tenga que cambiar entre local con
# contenedores y local sin ellos.
FRONT_BIND=127.0.0.1
FRONT_PORT=5173

# ── Limites de recursos del contenedor ───────────────────────────────
FRONTEND_CPUS_LIMIT=0.25
FRONTEND_MEMORY_LIMIT=64M
